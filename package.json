{
  "name": "thornvale",
  "private": true,
  "version": "0.3.0",
  "description": "Thornvale - a top-down 3D fantasy MMORPG in the spirit of classic Tibia (Three.js + TypeScript + Vite, Node multiplayer server)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "server": "tsx server/server.ts",
    "test:logic": "tsx scripts/smoke-test.ts && tsx scripts/depots-test.ts && tsx scripts/pvpbots-test.ts && tsx scripts/stages-test.ts && tsx scripts/activity-test.ts && tsx scripts/shields-test.ts && tsx scripts/pets-test.ts",
    "test:pvpbots": "tsx scripts/pvpbots-test.ts",
    "test:net": "tsx scripts/net-test.ts",
    "saves:backup": "tsx scripts/saves.ts backup",
    "saves:import": "tsx scripts/saves.ts import",
    "saves:check": "tsx scripts/saves.ts check",
    "test:storage": "tsx scripts/storage-test.ts",
    "test:auth": "tsx scripts/auth-test.ts",
    "test:bosses": "tsx scripts/boss-test.ts",
    "test:store": "tsx scripts/store-test.ts"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "@types/node": "^20.11.0"
  },
  "engines": {
    "node": ">=20"
  }
}
